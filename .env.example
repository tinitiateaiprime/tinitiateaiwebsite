# Copy to .env.local for local testing. In production, add these in
# Azure Portal → App Service (tinitiate-web) → Settings → Environment variables.

# --- Enquiry email (Request Callback + Contact forms) ---
# Any SMTP provider works: Microsoft 365 (smtp.office365.com:587),
# Google Workspace (smtp.gmail.com:587, app password), Zoho (smtp.zoho.in:587),
# Amazon SES SMTP (email-smtp.us-east-1.amazonaws.com:587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: sender address (defaults to SMTP_USER) and inbox (defaults to contact@tinitiateai.com)
CONTACT_FORM_FROM=
CONTACT_FORM_TO=contact@tinitiateai.com

# --- Optional backup copy of each enquiry in Azure Cosmos DB ---
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=tinitiate
COSMOS_CONTAINER=items
