{
  "name": "tinitiateai-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@lexical/headless": { "happy-dom": "21.0.4" },
    "source-map-js": "1.2.2",
    "zod": "4.6.6"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --test tests/import-utils.test.mjs",
    "test:e2e": "playwright test",
    "dev:local": "node scripts/local.mjs dev",
    "build:local": "node scripts/local.mjs build",
    "start:local": "node scripts/local.mjs start",
    "import:azure": "node scripts/local.mjs import",
    "import:enquiries": "node scripts/local.mjs enquiries",
    "test:fixtures": "node scripts/local.mjs fixtures",
    "import:postgres-preview": "node scripts/preview-postgres.mjs",
    "academy:prepare": "node scripts/academy/prepare.mjs",
    "academy:init": "node scripts/academy/local.mjs initialize",
    "academy:import": "node scripts/academy/local.mjs academy",
    "academy:fixtures": "node scripts/academy/local.mjs academy-fixtures",
    "academy:dev": "node scripts/academy/local.mjs dev",
    "academy:build": "node scripts/academy/local.mjs build",
    "academy:start": "node scripts/academy/local.mjs start",
    "academy:worker": "node scripts/academy/local.mjs worker",
    "academy:types": "payload generate:types",
    "academy:migrations": "payload run scripts/academy/migrations.mjs",
    "test:academy": "node --test tests/academy.test.mjs tests/preview-projection.test.mjs",
    "academy:preview-setup": "node scripts/academy/local.mjs phase2c-setup",
    "academy:notifications": "node scripts/academy/local.mjs notifications",
    "academy:phase2c-migrations": "payload run scripts/academy/phase2c-migrations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@google/genai": "^2.23.0",
    "@neon/config": "^1.7.0",
    "@neon/env": "^1.4.1",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@tailwindcss/typography": "^0.5.20",
    "acorn": "8.18.0",
    "cheerio": "^1.1.2",
    "framer-motion": "^14.11.1",
    "googleapis": "^182.0.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.47.0",
    "next": "16.4.6",
    "nodemailer": "^10.0.10",
    "payload": "3.93.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "8.20.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
